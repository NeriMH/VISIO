#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

 CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

 app.baseURL = 'http://10.141.131.66/VISIO_Codeigniter/public/';
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# GOOGLE (login com Google — tela de login do usuário)
#--------------------------------------------------------------------
# ADICIONADO: sem isto, o botão "Continuar com o Google" nem aparece na
# tela de login (a view só desenha o botão se este valor não estiver
# vazio) e o AuthController::loginGoogle() sempre recusa o token.
# PREENCHER com o Client ID OAuth (tipo "Web application") criado no
# Google Cloud Console para este projeto.

 GOOGLE_CLIENT_ID =

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

 database.default.hostname = localhost
 database.default.database = bd_visio
 database.default.username = root
 database.default.password = root
# database.default.DBDriver = MySQLi
# database.default.DBPrefix =
# database.default.port = 3306

# If you use MySQLi as tests, first update the values of Config\Database::$tests.
# database.tests.hostname = localhost
# database.tests.database = ci4_test
# database.tests.username = root
# database.tests.password = root
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# EMAIL (formulário de contato — Web e Mobile)
#--------------------------------------------------------------------
# ADICIONADO: sem estas chaves, ContatoController::enviar() responde
# erro 500 ("Envio de contato ainda não configurado no servidor") —
# ele não finge sucesso quando o envio não está configurado.
# PREENCHER com os dados da conta de e-mail que vai enviar as
# mensagens (ex.: Gmail com senha de app) e o e-mail que deve RECEBER
# as mensagens do formulário.

 email.protocol = smtp
 email.SMTPHost = smtp.gmail.com
 email.SMTPUser = visio.suporte1@gmail.com
 email.SMTPPass = anytjdrjsjjpyqta
 email.SMTPPort = 465
 email.SMTPCrypto = ssl
 email.fromEmail = visio.suporte1@gmail.com
 email.fromName = VISIO
 email.SMTPTimeout = 30
 CONTATO_EMAIL_DESTINO = visio.suporte1@gmail.com

